@page "/bookings"
@inject GymManagement.Web.Services.GymDataStore Store
@inject GymManagement.BookingService BookingSvc
@inject GymManagement.WaitlistService WaitlistSvc
@inject GymManagement.Web.Services.PersistenceService Persistence
@using GymManagement

<PageTitle>Bookings</PageTitle>

<h1>Bookings</h1>

@if (!string.IsNullOrEmpty(message))
{
    <div class="alert @(isError ? "alert-danger" : "alert-success")">@message</div>
}

<!-- books a member into a class -->
<h3>Book a Class</h3>
<EditForm Model="bookForm" OnValidSubmit="Book">
    <div class="mb-2">
        <label>Member</label>
        <InputSelect class="form-control" @bind-Value="bookForm.MemberId">
            <option value="">-- select --</option>
            @foreach (var m in Store.Members)
            {
                <option value="@m.MemberId">@m.MemberName (@m.MemberId)</option>
            }
        </InputSelect>
    </div>
    <div class="mb-2">
        <label>Class</label>
        <InputSelect class="form-control" @bind-Value="bookForm.ClassId">
            <option value="">-- select --</option>
            @foreach (var c in Store.Classes)
            {
                var waitingHere = Store.Waitlist.Count(w => w.FitnessClass.Id == c.Id);
                <option value="@c.Id">
                    @c.Name (@c.AvailableSlots free@(waitingHere > 0 ? $", {waitingHere} waiting" : ""))
                </option>
            }
        </InputSelect>
    </div>
    <button type="submit" class="btn btn-primary">Book</button>
    <button type="button" class="btn btn-outline-warning"
            @onclick="JoinWaitlist">
        Join Waitlist (if full)
    </button>
</EditForm>

@if (Store.Waitlist.Any())
{
    <h3 class="mt-4">Waitlist</h3>
    <table class="table table-sm">
        <thead>
            <tr><th>Member</th><th>Class</th><th>Added</th></tr>
        </thead>
        <tbody>
            @foreach (var w in Store.Waitlist.OrderBy(w => w.AddedAt))
            {
                <tr>
                    <td>@w.Member.MemberName</td>
                    <td>@w.FitnessClass.Name</td>
                    <td>@w.AddedAt.ToString("g")</td>
                </tr>
            }
        </tbody>
    </table>
}

<!-- shows every booking with cancel and check-in buttons -->
<h3 class="mt-4">All Bookings</h3>
<table class="table table-striped">
    <thead>
        <tr><th>Member</th><th>Class</th><th>Status</th><th></th></tr>
    </thead>
    <tbody>
        @foreach (var b in Store.Bookings)
        {
            <tr>
                <td>@b.Member.MemberName</td>
                <td>@b.FitnessClass.Name</td>
                <td>
                    @if (b.IsCancelled)
                    {
                        <span class="badge bg-secondary">Cancelled</span>
                    }
                    else
                    {
                        <span class="badge bg-success">Active</span>
                    }
                </td>
                <td>
                    @if (!b.IsCancelled)
                    {
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => Cancel(b)">Cancel</button>
                        <button class="btn btn-sm btn-outline-success" @onclick="() => CheckIn(b)">Check In</button>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Store.Bookings.Any())
{
    <p class="text-muted">No bookings yet.</p>
}

@code {
    // holds what's picked in the booking form
    private class BookForm
    {
        public string MemberId { get; set; } = "";
        public string ClassId { get; set; } = "";
    }

    private BookForm bookForm = new();
    private string? message;
    private bool isError;

    // books the class - BookingService returns a result rather than throwing,
    // so we check .Success here instead of try/catch
    // (doesn't stop the same member booking the same class twice yet - GAP-01)
    private void Book()
    {
        var member = Store.FindMember(bookForm.MemberId);
        var fitnessClass = Store.FindClass(bookForm.ClassId);

        if (member == null || fitnessClass == null)
        {
            message = "Select both a member and a class.";
            isError = true;
            return;
        }

        var result = BookingSvc.BookClass(member, fitnessClass);
        message = result.Message;
        isError = !result.Success;

        if (result.Success && result.Booking != null)
        {
            Store.Bookings.Add(result.Booking);
            Persistence.Save(Store);
        }
    }

    // cancels a booking and frees the class slot back up. If someone's waiting
    // for this class, they are auto-promoted into the freed slot.
    private void Cancel(Booking booking)
    {
        var result = BookingSvc.CancelBooking(booking);
        message = result.Message;
        isError = !result.Success;

        if (result.Success)
        {
            // Try to promote the oldest waitlister for this class.
            var promote = WaitlistSvc.PromoteNext(booking.FitnessClass, Store.Waitlist);
            if (promote.Success && promote.PromotedBooking != null)
            {
                Store.Bookings.Add(promote.PromotedBooking);
                message = $"{result.Message} {promote.Message}";
            }

            Persistence.Save(Store);
        }
    }

    // Adds the currently selected member to the waitlist for the currently
    // selected class. Only works when the class is already full.
    private void JoinWaitlist()
    {
        var member = Store.FindMember(bookForm.MemberId);
        var fitnessClass = Store.FindClass(bookForm.ClassId);

        if (member == null || fitnessClass == null)
        {
            message = "Select both a member and a class to join the waitlist.";
            isError = true;
            return;
        }

        var result = WaitlistSvc.Join(member, fitnessClass, Store.Waitlist);
        message = result.Message;
        isError = !result.Success;

        if (result.Success && result.Entry != null)
        {
            Store.Waitlist.Add(result.Entry);
            Persistence.Save(Store);
        }
    }

    // checks in a member for their confirmed booking - uses the
    // booking-based CheckIn constructor so attendance is tied to a
    // real, confirmed booking rather than membership status alone (FR13)
    private void CheckIn(Booking booking)
    {
        try
        {
            var checkIn = new CheckIn(booking, Store.CheckIns);
            Store.CheckIns.Add(checkIn);
            message = $"Checked in {booking.Member.MemberName} for '{booking.FitnessClass.Name}'.";
            isError = false;
            Persistence.Save(Store);
        }
        catch (Exception ex)
        {
            message = ex.Message;
            isError = true;
        }
    }
}